{
  "name": "data_profiling",
  "version": "0.2.0",
  "description": "Exact DuckDB profiling with schema-directed native aggregate plans",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc",
    "prepare": "npm run build",
    "pretest": "node -e \"require('node:fs').rmSync('.test-dist', {recursive: true, force: true})\"",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "bench": "npm run build && node benchmarks/profile.mjs"
  },
  "devDependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
