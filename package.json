{
  "name": "data_profiling",
  "version": "0.4.0",
  "description": "High-performance data profiling with native DuckDB execution",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    }
  },
  "files": [
    "dist",
    "python-requirements.txt",
    "docs/metrics.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc && node -e \"require('node:fs').copyFileSync('src/worker.py', 'dist/worker.py')\"",
    "prepare": "npm run build",
    "pretest": "node -e \"require('node:fs').rmSync('.test-dist', {recursive: true, force: true})\"",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "bench": "npm run build && node benchmarks/profile.mjs",
    "bench:algorithms": "npm run build && node benchmarks/algorithms.mjs",
    "dev:site": "vite --config site/vite.config.ts",
    "build:site": "tsc -p site/tsconfig.json && vite build --config site/vite.config.ts"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@duckdb/node-api": "2.0.0-r.1",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
